<!doctype html>
<html lang="en" data-bs-theme="auto">
	<head>
		<script src="assets/js/color-modes.js"></script>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="description" content="User registration page">
		<meta name="author" content="Your Company Name">
		<meta name="generator" content="Hugo 0.122.0">
		<title>Register</title>
		<link href="assets/twbs/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
		<script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
		<link href="https://fonts.googleapis.com/css?family=Montserrat:400,700" rel="stylesheet"/>
		<link href="https://fonts.googleapis.com/css?family=Roboto+Slab:400,100,300,700" rel="stylesheet"/>
		<link href="/assets/css/homeStyles.css" rel="stylesheet"/>
		<link rel="icon" href="/assets/img/pp.png" type="image/png">

		<style>

			body {
				background-image: url('/assets/img/background-login.png');
				background-size: cover;
				background-position: center;
			}

			@keyframes slideIn {
				from {
					transform: translateX(-100%);
					opacity: 0;
				}
				to {
					transform: translateX(0);

					opacity: 1;
				}
			}

			.register-container {
				max-width: 400px;
				width: 100%;
				padding: 2rem;
				background-color: gold;
				border-radius: 25px;
				box-shadow: 0 4px 12px rgb(0, 0, 0);
				animation: slideIn 1s ease-out forwards; /* Solo una vez y permanece en el estado final */

			}
			.register-title {
				font-size: 2.5rem;
				margin-bottom: 1rem;
				font-weight: 800;
				color: #333;
			}
		</style>
	</head>

	<body class="bg-light">
		<div class="container d-flex justify-content-center align-items-center min-vh-100">

			<div class="position-absolute top-0 start-0 p-3">
				<a href="/home" class="btn btn-light">
					<i class="fas fa-home"></i>
					{{ translations['Volver a Inicio'] }}
				</a>
			</div>


			<div class="register-container">
				<h1 class="register-title text-center">{{ translations['Registro'] }}</h1>


				{% if message %}
					<div class="alert alert-success text-center fw-bold shadow-sm">
						{{ message }}
					</div>
				{% endif %}
				{% if error %}
					<div class="alert alert-danger text-center fw-bold shadow-sm">
						{{ error }}
					</div>
				{% endif %}


				<form method="POST">
					<div class="form-group mb-3">
						<label for="inputName" class="form-label">{{ translations['Nombre completo'] }}</label>


						<input type="text" id="inputName" name="username" class="form-control" placeholder="Full Name" required>
					</div>
					<div class="form-group mb-3">
						<label for="inputEmail" class="form-label">{{ translations['Email'] }}</label>


						<input type="email" id="inputEmail" name="email" class="form-control" placeholder="Email address" required>
					</div>
					<div class="form-group mb-4">
						<label for="inputPassword" class="form-label">{{ translations['Contraseña'] }}</label>


						<input type="password" id="inputPassword" name="password" class="form-control" placeholder="Password" required>
					</div>
					<button class="btn btn-dark w-100 btn-lg" type="submit">{{ translations['Registro'] }}</button>

					<p class="text-center mt-3">
						{{ translations['¿Ya tienes una cuenta?'] }}

						<a class="c-inh" href="login">{{ translations['Iniciar sesión'] }}</a>


					</p>
					<p class="text-center mt-4 mb-3 text-muted">&copy; Phone Phony</p>
				</form>
			</div>
		</div>
		<script src="assets/twbs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	</body>
</html>
