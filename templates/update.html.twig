<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Editar Teléfono</title>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-table@1.23.5/dist/bootstrap-table.min.css">
		<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">

	</head>
	<body>


		<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
			<div class="container-fluid">
				<a class="navbar-brand text-white" href="/dashboard">Dashboard</a>
				<div class="collapse navbar-collapse justify-content-end">
					<ul class="navbar-nav">
						<li class="nav-item">
							<form method="POST" action="/logout">
								<button type="submit" class="btn btn-outline-light">Cerrar Sesión</button>
							</form>
						</li>
					</ul>
				</div>
			</div>
		</nav>


		<div class="d-flex" style="height: 100vh;">
			<div class="bg-secondary text-white p-3" style="width: 250px;">

				<h4>Menú</h4>
				<ul class="nav flex-column">
					<li class="nav-item">
						<a class="nav-link text-white" href="/create">
							<i class="bi bi-plus"></i>
							Agregar Móvil
						</a>
					</li>
				</ul>
			</div>


			<div class="container mt-5">
				<h1>Editar Teléfono</h1>
				<form method="POST">
					<input type="hidden" name="id" value="{{ phone.id }}">
					<div class="mb-3">
						<label for="name" class="form-label">Nombre</label>
						<textarea class="form-control" id="name" name="name" required>{{ phone.name }}</textarea>
					</div>
					<div class="mb-3">
						<label for="price" class="form-label">Precio</label>
						<input type="text" class="form-control" id="price" name="price" value="{{ phone.price }}" required>
					</div>
					<div class="mb-3">
						<label for="marca_id" class="form-label">idMarca</label>
						<input type="numbre" class="form-control" id="marca_id" name="marca_id" value="{{ phone.marca_id }}" disabled>
					</div>

					<div class="mb-3">
						<label for="marca_id" class="form-label">Marca</label>
						<select class="form-select" id="marca_id" name="marca_id" required>
							<option value="1" {% if phone.marca_id == 1 %} selected {% endif %}>Apple</option>
							<option value="2" {% if phone.marca_id == 2 %} selected {% endif %}>Samsung</option>
							<option value="3" {% if phone.marca_id == 3 %} selected {% endif %}>Xiaomi</option>
							<option value="4" {% if phone.marca_id == 4 %} selected {% endif %}>Google</option>
						</select>
					</div>
					<button type="submit" class="btn btn-primary">Guardar Cambios</button>
					<a href="/dashboard" class="btn btn-secondary">Cancelar</a>
				</form>
			</div>
		</div>
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	</body>
</html></body></html>
