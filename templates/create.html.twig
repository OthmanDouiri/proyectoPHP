<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Crear Teléfono</title>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-table@1.23.5/dist/bootstrap-table.min.css">
		<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
		<link href="/assets/css/homeStyles.css" rel="stylesheet"/>

		<link rel="icon" href="/assets/img/pp.png" type="image/png">

	</head>

	<body>


<nav class="navbar navbar-expand-lg navbar-dark bg-dark w-100">
    <div class="container-fluid px-3">
        <a class="navbar-brand text-white" href="/dashboard">Dashboard</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" 
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
            <ul class="navbar-nav d-flex align-items-center">
                <li class="nav-item">
                    <form method="POST" action="/logout" class="d-flex">
                        <button type="submit" class="btn btn-outline-light">
                            <i class="fa fa-sign-out"></i> Cerrar Sesión
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</nav>


		<div class="d-flex" style="height: 100vh;">
			<div class="bg-dark text-white p-3" style="width: 250px;">

				<h4>Menú</h4>
				<ul class="nav flex-column">
					<li class="nav-item">
						<a class="nav-link text-white a-h" href="/create">
							<i class="fa fa-plus"></i>
							Agregar Móvil
						</a>
					</li>
				</ul>
			</div>


			<div class="container mt-5">
				<h1 class="mb-4">Crear Teléfono</h1>
				{% if successMessage %}
					<div class="alert alert-success d-flex justify-content-between align-items-center" role="alert">
						{{ successMessage }}
						<a href="/dashboard" class="btn btn-success btn-sm">Ir al Dashboard</a>
					</div>
				{% endif %}
				<!-- Formulario de creación -->
				<form method="POST">
					<div class="mb-3">
						<label for="name" class="form-label">Nombre</label>
						<input type="text" class="form-control" id="name" name="name" placeholder="Introduce el nombre del teléfono" required>
					</div>

					<div class="mb-3">
						<label for="price" class="form-label">Precio</label>
						<input type="text" class="form-control" id="price" name="price" placeholder="Introduce el precio del teléfono" required>
					</div>

					<div class="mb-3">
						<label for="marca_id" class="form-label">Marca</label>
						<select class="form-select" id="marca_id" name="marca_id" required>
							<option value="1" {% if phone.marca_id == 1 %} selected {% endif %}>Apple</option>
							<option value="2" {% if phone.marca_id == 2 %} selected {% endif %}>Samsung</option>
							<option value="3" {% if phone.marca_id == 3 %} selected {% endif %}>Xiaomi</option>
							<option value="4" {% if phone.marca_id == 4 %} selected {% endif %}>Google</option>
						</select>
					</div>

					<div class="mb-5">
						<label for="image_url" class="form-label">Image_url</label>
						<input type="text" class="form-control" id="image_url" name="image_url" placeholder="URL imagen" required>
					</div>

					<button type="submit" class="btn btn-primary">Crear</button>
					<a href="/dashboard" class="btn btn-secondary">Cancelar</a>
				</form>
			</div>
		</div>

		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	</body>
</html></body></html>
