<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-table@1.23.5/dist/bootstrap-table.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
</head>
<body>

    <div class="container mt-5">
        <!-- Formulario para cerrar sesión -->
        <div class="d-flex justify-content-end">
            <form method="POST">
                <a href="/logout" class="btn btn-dark">Cerrar sesión</a>
            </form>
        </div>
        <h1>Bienvienido, {{ username }} !</h1>
        
        <p>Este es tu panel de administración.</p>
    </div>


    <div class="container mt-3">
        <form method="GET" action="/dashboard" class="d-flex mb-4">
            <input 
                type="text" 
                name="search" 
                class="form-control me-2" 
                placeholder="Buscar por nombre o precio..." 
                value="{{ search_query | default('') }}"
            >
            <button type="submit" class="btn btn-primary">Buscar</button>
        </form>

        <!-- si no hay resultados -->
        {% if noResultsMessage %}
        <div class="alert alert-warning" role="alert">
            <strong>{{ noResultsMessage }}</strong>
        </div>
        {% endif %}
    
    </div>
   
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Lista de Teléfonos</h1>
            <!-- Add phone button -->
            <a href="/create" class="btn btn-primary">
                <i class="bi bi-plus"></i> Agregar Teléfono
            </a>
        </div>
       
        <table class="table table-bordered" 
        data-toggle="table" 
        data-pagination="true" 
        data-page-size="5"
        data-locale="es-ES">

            <thead class="table-dark">
                <tr>
                    <th>id</th>
                    <th>Nombre</th>
                    <th>Precio</th>
                    <!--<th>idMarca</th> -->
                    <th>Marca</th>
                    <th>Acción</th>

                    
                </tr>
            </thead>
            <tbody>
                    {% for phone in phones %}
                    <tr>
                        <td>{{ phone.id }}</td>
                        <td>{{ phone.name }}</td>
                        <td>{{ phone.price }}</td>
                         <!--<td>{{ phone.marca_id }}</td>-->
                        <td>{{ phone.marca_nombre }}</td>
                        <td>
                            <div class="d-flex gap-2">
                                <a href="update?id={{ phone.id }}" class="btn btn-success">Editar</a>
                                <form method="POST" onsubmit="return confirm('¿Estás seguro de que deseas eliminar este teléfono?');">
                                    <input type="hidden" name="phone_id" value="{{ phone.id }}">
                                    <button type="submit" class="btn btn-danger">Eliminar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
            </tbody>
        </table>
    </div>



    <div class="container mt-5">
        <h2>Estadísticas</h2>
        <canvas id="priceChart" width="400" height="200"></canvas>
        <canvas id="brandChart" width="400" height="200" class="mt-4"></canvas>
    </div>





    <script src="https://cdn.jsdelivr.net/npm/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-table@1.23.5/dist/bootstrap-table.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-table@1.23.5/dist/locale/bootstrap-table-es-ES.min.js"></script>

    <!--script para librerias de chart.js -->

    
</body>
</html>